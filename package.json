{
  "name": "dsh-channel-memory",
  "version": "0.1.2",
  "description": "微信通道专属工作区 + 跨会话互通记忆：把手机发起的 DSH 会话归到一个独立工作区，并让所有会话共享一份可检索的长期记忆。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yuncan050115/dsh-channel-memory.git"
  },
  "bugs": {
    "url": "https://github.com/Yuncan050115/dsh-channel-memory/issues"
  },
  "homepage": "https://github.com/Yuncan050115/dsh-channel-memory#readme",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "PERMISSIONS.md",
    "LICENSE",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "wechat",
    "memory",
    "workspace"
  ]
}
